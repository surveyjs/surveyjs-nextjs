{
  "name": "surveyjs-nextjs",
  "version": "2.0.0",
  "private": true,
  "description": "The Next.js code behind the SurveyJS backend integration docs: 18 examples on Next.js 16 with route handlers and shadcn/ui",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node server.ts --dev",
    "build": "next build",
    "start": "node server.ts --production",
    "setup": "node scripts/setup.ts",
    "lint": "eslint .",
    "test": "node --test \"test/*.test.ts\"",
    "check": "node scripts/check.ts",
    "contract": "node scripts/contract.ts",
    "readme": "node scripts/readme.ts",
    "e2e:ci": "playwright install chromium && playwright test",
    "e2e:dev": "playwright install chromium && playwright test --config=playwright.dev.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surveyjs/surveyjs-nextjs.git"
  },
  "license": "https://surveyjs.io/licensing",
  "dependencies": {
    "@anthropic-ai/sdk": "~0.90.0",
    "@base-ui/react": "^1.9.0",
    "ai-form-response-extractor": "^0.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "highlight.js": "^11.12.0",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "openai": "^6.49.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "~0.33.5",
    "survey-analytics": "3.2.7",
    "survey-core": "3.2.7",
    "survey-creator-core": "3.2.7",
    "survey-creator-react": "3.2.7",
    "survey-pdf": "3.2.7",
    "survey-react-ui": "3.2.7",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
